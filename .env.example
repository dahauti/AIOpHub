# Environment profile: dev | prod
# Selects the default database and which DEV_/PROD_ overrides below are active.
APP_ENV=dev

# Per-environment overrides (optional; unset -> the shared values further below)
# DEV_BC_COMPANY=your-dev-company-name
# PROD_BC_COMPANY=your-prod-company-name
# DEV_FRONTU_BASE_URL=https://your-dev-subdomain.frontu.com/client/api/v2
# PROD_FRONTU_BASE_URL=https://your-subdomain.frontu.com/client/api/v2
# DEV_FRONTU_API_KEY=your-dev-frontu-api-token
# PROD_FRONTU_API_KEY=your-prod-frontu-api-token

# Database (embedded SQLite, WAL mode; path is relative to the working directory)
# One file per environment holds vehicle + task state, run locks and the audit log:
#   dev  -> sqlite+aiosqlite:///./data/aio_dev.db
#   prod -> sqlite+aiosqlite:///./data/aio_prod.db
# Set DATABASE_URL only to override that (e.g. to keep an existing ./data/sync.db).
# DATABASE_URL=sqlite+aiosqlite:///./data/sync.db

# Task sync: overlap subtracted from the BC task watermark on every poll (15 min default)
TASK_SAFETY_BUFFER_SECONDS=900

# Business Central SaaS (Entra ID)
BC_TENANT_ID_SAAS=your-tenant-id-guid
BC_CLIENT_ID_SAAS=your-app-registration-client-id
BC_CLIENT_SECRET_SAAS=your-client-secret-value
BC_ENVIRONMENT_SAAS=Production
BC_COMPANY_ID_SAAS=your-company-guid-or-name

# Frontu API Prod
FRONTU_API_KEY=your-frontu-api-token
FRONTU_SUBDOMAIN=your-subdomain
INTERNAL_COMPANY_CLIENT_ID=your-internal-company-client-id

# App settings
LOG_LEVEL=INFO
APP_PORT=8000
BC_ACTIVE_PROFILE=onprem
SYNC_INTERVAL_SECONDS=300
# Safety gates: keep the daemon off and dry-run on until a live run is approved
SYNC_ENABLED=false
SYNC_DRY_RUN=true

# Business Central OnPrem Prod
BC_TENANT_ID_ONPREM=your-tenant-id-guid
BC_CLIENT_ID_ONPREM=your-client-id-guid
BC_CLIENT_SECRET_ONPREM=your-client-secret-value
BC_SCOPE_ONPREM=https://api.businesscentral.dynamics.com/.default
BC_ODATA_BASE_URL_ONPREM=https://bc.company.local:7048/BC/ODataV4
BC_COMPANY_ID_ONPREM=your-company-name
