# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/aiophub

# Business Central SaaS (Entra ID)
BC_TENANT_ID=your-tenant-id-guid
BC_CLIENT_ID=your-app-registration-client-id
BC_CLIENT_SECRET=your-client-secret-value
BC_ENVIRONMENT=Production
BC_COMPANY_ID=your-company-guid-or-name

# Frontu API
FRONTU_API_KEY=your-frontu-api-token
FRONTU_BASE_URL=https://api.frontu.com/v2

# App settings
LOG_LEVEL=INFO
APP_PORT=8000
